# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-mineru/
venv/
env/

# Secrets (keep the committed *.example templates)
.env
.env.*
!.env.example

# Node / frontend build output
node_modules/
frontend/dist/
frontend/node_modules/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
.cursor/
.claude/
*.ses

# Logs and databases (may contain user data)
logs/
*.log
*.db
*.sqlite
*.sqlite3
*.jsonl

# Generated data. Real documents and indexes stay out of the repo; the
# directory structure is kept via .gitkeep.
data/raw/*
data/processed/*
data/metadata/*
data/metadata/rag/*
data/imports/
data/*.csv
!data/*/.gitkeep
