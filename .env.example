# UniAssist environment variables

# Data directory override (optional)
# UNIASSIST_DATA_DIR=./data

# UniAssist API (Phase 7)
# UNIASSIST_PROJECT_ROOT=.
# UNIASSIST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# UNIASSIST_MAX_QUESTION_LENGTH=2000

# NVIDIA NIM (local development defaults to local NIM on port 8000)
# NVIDIA_BASE_URL=http://localhost:8000/v1
# NVIDIA_API_KEY=
# NVIDIA_CHAT_MODEL=
# NVIDIA_EMBEDDING_MODEL=
# NVIDIA_TIMEOUT_SECONDS=60
# UNIASSIST_RUN_NVIDIA_INTEGRATION=0
# UNIASSIST_EMBEDDING_PROVIDER=nvidia
# UNIASSIST_MIN_SCORE=0.35
# UNIASSIST_USE_NVIDIA_VERIFIER=1

# Hosted NVIDIA fallback example:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=your_api_key_here
# NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# ScrapeAI / SUSU (future phases)
# SUSU_BASE_URL=
# SCRAPEAI_RATE_LIMIT_PER_SECOND=

# Telegram student bot (Phase 9)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# UNIASSIST_API_URL=http://127.0.0.1:8001
# TELEGRAM_RATE_LIMIT_PER_MINUTE=10
# TELEGRAM_REQUEST_TIMEOUT_SECONDS=60
# TELEGRAM_MAX_MESSAGE_LENGTH=4096
# UNIASSIST_RUN_TELEGRAM_INTEGRATION=0

# Persistence backend (Phase 10)
# UNIASSIST_STORAGE_BACKEND=local
# UNIASSIST_DATA_DIR=./data

# Appwrite Cloud (production persistence)
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_API_KEY=
# APPWRITE_DATABASE_ID=
# APPWRITE_DOCUMENTS_COLLECTION_ID=
# APPWRITE_PROCESSING_COLLECTION_ID=
# APPWRITE_CHUNKS_COLLECTION_ID=
# APPWRITE_RAW_BUCKET_ID=
# APPWRITE_PROCESSED_BUCKET_ID=
# UNIASSIST_RUN_APPWRITE_INTEGRATION=0
